<div class="pdf-wrapper">
  <div class="header">
    <h1><%= destination.location %> &ndash; Pocket Guide</h1>
    <p>Duration: <%= trip.number_days %> Days | Generated by WanderPlan AI</p>
  </div>

  <% @daily_schedule.each do |day| %>
    <div class="day-card" style="page-break-inside: avoid; margin-bottom: 20px;">
      <h2 class="day-header"><%= day['dayNumber'] %></h2>

      <% %w[morning afternoon evening].each do |slot_name| %>
        <% slot = day[slot_name] %>
        <% next unless slot %>

        <div class="activity-slot" style="margin-bottom: 14px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
          <span class="badge" style="text-transform: uppercase; font-weight: bold; color: #0369a1;">
            <%= slot_name %>
          </span>
          <strong><%= slot['place'] %></strong>
          <span class="cost" style="color: #0d9488;">
            ($<%= slot['budgetEstimate'] %> USD)
          </span>

          <p style="margin: 4px 0;"><%= slot.dig('activity', 'description') %></p>

          <% if slot.dig('activity', 'specialNote').present? %>
            <p class="note" style="font-size: 9pt; color: #64748b; font-style: italic;">
              <strong>Note:</strong> <%= slot.dig('activity', 'specialNote') %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>