{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mui-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mui/mcp@latest"],
      "enabled": true,
      "timeout": 10000,
    },
    "tripadvisor-content": {
      "type": "remote",
      "enabled": true,
      "url": "https://docs.terra.tripadvisor.com/mcp",
      "timeout": 10000,
    },
  },
}
